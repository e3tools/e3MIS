# Template for the VM's .env (next to docker-compose.yaml). Only the MIS-related lines are listed;
# keep the other lines already in the VM's .env (CouchDB, MinIO, Kobo, DIAGNOSTIC_MAP_*...).
# Never commit the real file.

# Keep the CURRENT value: changing it invalidates every issued MIS API token.
SECRET_KEY=<unchanged>
DEBUG=False

DATABASE_URL=postgres://postgres:<password>@db:5432/smp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DB=smp

ALLOWED_HOSTS=mis.coso.gouv.bj,10.205.3.45,10.205.3.46,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://mis.coso.gouv.bj

# New with the field monitoring. Set BEFORE the first start: the programme settings are created
# on first use with this value (default Africa/Abidjan is one hour off for Benin).
PROGRAMME_TIMEZONE=Africa/Porto-Novo

# Only if the supervision dashboard is served from another domain, e.g. https://dashboard.example.org
# CORS_ALLOWED_ORIGINS=

MAPBOX_ACCESS_TOKEN=<token>

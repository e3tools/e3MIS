#: authorization/models.py
msgid "The supervisor must be an SC in the same commune."
msgstr "Le superviseur doit être un SC de la même commune."

#: authorization/models.py
msgid "Only FTs and FCs have a supervisor."
msgstr "Seuls les FT et les FC ont un superviseur."

#: authorization/models.py
msgid "FT, FC and SC users need a commune."
msgstr "Les FT, FC et SC doivent avoir une commune."

#: authorization/models.py
msgid "A regional specialist needs a region."
msgstr "Un spécialiste régional doit avoir une région."

